or i in 0..KEY_PART_LENGTH {\n            y[i] = flattened[KEY_PART_LENGTH + i];\n        }\n\n        PubKey::new(x, y)\n    }\n\n    pub fn get_address(self) -> [u8; ADDRESS_LENGTH] {\n        let hash = keccak256(self.flatten(), KEY_LENGTH);\n\n        let mut address = [0; ADDRESS_LENGTH];\n        for i in 12..KEY_LENGTH {\n            address[i - 12] = hash[i];\n        }\n        address\n    }\n\n    pub fn flatten(self) -> [u8; KEY_LENGTH] {\n        let mut flat = [0; KEY_LENGTH];\n        for i in 0..KEY_PART_LENGTH {\n            flat[i] = self.x[i];\n            flat[KEY_PART_LENGTH + i] = self.y[i];\n        }\n        flat\n    }\n\n    pub fn verify_flatten_signature(\n        self,\n        signature: [u8; KEY_LENGTH],\n        message: [u8; MESSAGE_LENGTH],\n    ) -> bool {\n        verify_signature(self.x, self.y, signature, message)\n    }\n}\n","path":"/Users/thomas_grk/Library/Mobile Documents/com~apple~CloudDocs/Work/Perso/Code/zero_knowledge_solvency/circuits/zks/src/pub_key.nr"},"69":{"source":"mod pub_key;\nuse pub_key::PubKey;\n\nfn main(\n    field_message: [u8; 32],\n    field_signature: [u8; 64],\n    field_pub_key: [u8; 64],\n    field_total_balance: u64,\n    field_solvency: pub u64,\n) {\n\n    let is_solvency_valid = verify_solvency(field_total_balance, field_solvency);\n\n    assert(is_solvency_valid == true, \"Solvency is not valid\");\n\n    let pub_key = PubKey::from_flattened(field_pub_key);\n\n    assert(pub_key.verify_flatten_signature(field_signature, field_message), \"Signature is not valid\");\n}\n\nfn verify_solvency(balance: u64, solvency: u64) -> bool {\n    (balance >= solvency)\n}\n\n#[test]\nfn test_solvency() {\n    assert(verify_solvency(100, 100) == true);\n    assert(verify_solvency(100, 101) == false);\n}\n\n#[test]\nfn test_valid_signature() {\n    let field_message = [\n        89,\n        111,\n        117,\n        32,\n        110,\n        101,\n        101,\n        100,\n        32,\n        116,\n     